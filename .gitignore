# Quartus/Qsys generated artifacts (HW synthesis)
# Keep key deliverables explicitly: rbf/dts/dtb/qpf/qsf and output_files/

# --- Ignore generated project files removed by `make clean` in `hw/` ---
/hw/*.sdc
/hw/*.srf
/hw/*.sopcinfo
/hw/output_files/*
!hw/output_files/
/hw/soc_system/
/hw/.qsys_edit/
/hw/hps_isw_handoff/

/hw/hps_sdram_p0_summary.csv
/hw/hps_sdram_p0_all_pins.txt
/hw/c5_pin_model_dump.txt

/hw/db/
/hw/incremental_db/

# Quartus database / intermediate
/hw/*.qdf

# Quartus output_files contains .sof and reports; keep it tracked
# (even though `make clean` deletes it)

# --- Ignore software build outputs pulled/generated by hw/makefile ---
/hw/software/spl_bsp/
/hw/software/linux-socfpga/

# --- Common editor/backup files ---
*~
*.swp
*.swo
.DS_Store

# --- Important Synth Files ---
# Keep only key, high-signal Quartus outputs (timing, resource usage, flow summary, pinout, and .rbf)
!hw/output_files/soc_system.rbf
!hw/output_files/soc_system.sta.rpt
!hw/output_files/soc_system.sta.summary
!hw/output_files/soc_system.fit.summary
!hw/output_files/soc_system.flow.rpt
!hw/output_files/soc_system.pin

# Keep key source/config artifacts
!hw/soc_system.rbf
!hw/soc_system.dts
!hw/soc_system.dtb
!hw/soc_system.qpf
!hw/soc_system.qsf
!hw/soc_system.qsys
!hw/soc_system.tcl
